{
  "name": "map",
  "version": "1.11.0",
  "description": "Local-first couple memory map desktop app",
  "author": "Map of Us",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:keepalive": "bash scripts/dev-keepalive.sh",
    "dev:daemon": "bash scripts/start-dev-daemon.sh",
    "build": "next build",
    "desktop:prepare": "npm run build && node scripts/prepare-standalone.mjs",
    "preview": "next start",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "desktop": "electron electron/main.js",
    "dist:dir": "npm run desktop:prepare && electron-builder --dir",
    "dist:mac": "npm run desktop:prepare && electron-builder --mac dmg",
    "dist:win": "npm run desktop:prepare && electron-builder --win nsis --x64",
    "perf:source": "node scripts/perf-source-metrics.mjs",
    "perf:css": "node scripts/perf-css-metrics.mjs",
    "perf:bundle": "node scripts/perf-bundle-analyze.mjs",
    "perf:api": "node scripts/perf-api-benchmark.mjs",
    "perf:storage": "node scripts/perf-storage-benchmark.mjs",
    "perf:electron": "node scripts/perf-electron-startup.mjs",
    "perf:baseline": "node scripts/perf-source-metrics.mjs && node scripts/perf-css-metrics.mjs && node scripts/perf-api-benchmark.mjs && node scripts/perf-storage-benchmark.mjs",
    "perf:diff": "node scripts/perf-diff-report.mjs"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.mapofus.desktop",
    "productName": "Map of Us",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "!node_modules/**/*",
      "electron/**/*",
      ".next/standalone/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
